---
import '../styles/global.css';
import { QueryProvider } from '../components/query-provider';
import { Toaster } from '../components/ui/sonner';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title || 'Anfal Watches — Premium Timepieces'}</title>
  </head>
  <body>
    <QueryProvider>
      <nav class="sticky top-0 z-50 border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
        <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
          <a href="/" class="font-heading text-xl tracking-wider">ANFAL</a>
          <div class="flex items-center gap-8">
            <a href="/" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">Home</a>
            <a href="/watches" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">Watches</a>
            <a href="/about" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">About</a>
            <a href="/contact" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">Contact</a>
            <a href="/faq" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">FAQ</a>
          </div>
        </div>
      </nav>
      <slot />
      <footer class="border-t">
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
          <div class="flex flex-col items-center gap-6 text-center">
            <span class="font-heading text-lg tracking-wider">ANFAL</span>
            <nav class="flex gap-6">
              <a href="/" class="text-xs font-medium uppercase tracking-widest text-muted-foreground transition-colors hover:text-foreground">Home</a>
              <a href="/watches" class="text-xs font-medium uppercase tracking-widest text-muted-foreground transition-colors hover:text-foreground">Watches</a>
              <a href="/about" class="text-xs font-medium uppercase tracking-widest text-muted-foreground transition-colors hover:text-foreground">About</a>
              <a href="/contact" class="text-xs font-medium uppercase tracking-widest text-muted-foreground transition-colors hover:text-foreground">Contact</a>
              <a href="/faq" class="text-xs font-medium uppercase tracking-widest text-muted-foreground transition-colors hover:text-foreground">FAQ</a>
            </nav>
            <p class="text-xs text-muted-foreground">Powered by Anfal Watches</p>
          </div>
        </div>
      </footer>
      <Toaster />
    </QueryProvider>
  </body>
</html>
