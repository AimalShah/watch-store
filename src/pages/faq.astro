---
import Layout from '../layouts/Layout.astro';
---

<Layout title="FAQ — Anfal Watches">
  <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6 lg:px-8">
    <p class="mb-2 text-sm font-medium uppercase tracking-[0.2em] text-secondary">FAQ</p>
    <h1 class="mb-8 font-heading text-4xl font-bold tracking-tight">Frequently Asked Questions</h1>
    <div class="space-y-8">
      <div>
        <h2 class="mb-2 font-heading text-lg font-semibold">How do I place an order?</h2>
        <p class="text-muted-foreground">Browse our collection, find a watch you love, and use the order form on the product page. We'll connect with you via WhatsApp to confirm your order.</p>
      </div>
      <div>
        <h2 class="mb-2 font-heading text-lg font-semibold">Are your watches authentic?</h2>
        <p class="text-muted-foreground">Yes, every watch we sell is 100% authentic. We source directly from authorized distributors and verify each timepiece before listing.</p>
      </div>
      <div>
        <h2 class="mb-2 font-heading text-lg font-semibold">What payment methods do you accept?</h2>
        <p class="text-muted-foreground">Payment is handled through WhatsApp chat. We accept bank transfers and other methods as agreed during the conversation.</p>
      </div>
    </div>
  </div>
</Layout>
