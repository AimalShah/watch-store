---
import Layout from '../layouts/Layout.astro';
const whatsappNumber = import.meta.env.PUBLIC_ADMIN_WHATSAPP_NUMBER || '+920000000000';
---

<Layout title="Contact — Anfal Watches">
  <div class="page">
    <div class="page-inner">
      <h1 class="headline-lg">Contact Us</h1>
      <p class="body-lg" style="color: var(--fg-muted); margin: 0 0 32px;">
        We'd love to hear from you. Reach out via WhatsApp or follow us on Instagram.
      </p>

      <div class="contact-grid">
        <a
          href={`https://wa.me/${whatsappNumber}`}
          target="_blank"
          class="contact-card"
        >
          <div class="contact-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" />
            </svg>
          </div>
          <h3 class="headline-md">WhatsApp</h3>
          <p class="body-md">Chat with us directly on WhatsApp for orders and inquiries.</p>
        </a>

        <a href="#" target="_blank" class="contact-card">
          <div class="contact-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </div>
          <h3 class="headline-md">Instagram</h3>
          <p class="body-md">Follow us @anfalwatches for the latest arrivals and updates.</p>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page {
    padding: 64px 16px;
  }

  .page-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .page h1 {
    margin: 0 0 8px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px;
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.2s;
  }

  .contact-card:hover {
    border-color: var(--accent);
  }

  .contact-card h3,
  .contact-card p {
    margin: 0;
  }

  .contact-card p {
    color: var(--fg-muted);
  }

  .contact-icon {
    color: var(--accent);
    margin-bottom: 8px;
  }

  @media (min-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
