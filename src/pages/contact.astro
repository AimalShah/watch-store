---
import Layout from '../layouts/Layout.astro';
import { generatePageMeta } from '../utils/seo';
const meta = generatePageMeta('contact');
---

<Layout {...meta}>
  <div class="mx-auto max-w-3xl px-4 py-24 sm:px-6 lg:px-8">
    <p class="mb-2 text-sm font-medium uppercase tracking-[0.2em] text-secondary">Contact</p>
    <h1 class="mb-8 font-heading text-4xl font-bold tracking-tight">Get in Touch</h1>
    <div class="space-y-4 text-muted-foreground">
      <p>Have questions about a timepiece or need assistance with an order? Reach out to us on WhatsApp and we'll be happy to help.</p>
      <p>Follow us on Facebook<span class="text-foreground">@25store</span> for the latest arrivals and updates.</p>
    </div>
  </div>
</Layout>
