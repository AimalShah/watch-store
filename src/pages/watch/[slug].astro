---
import Layout from '../../layouts/Layout.astro';
import { ProductDetail } from '../../components/product-detail';
import { createSupabaseServerClient } from '../../lib/supabase-server';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: product } = await supabase
  .from('products')
  .select('*, categories:category_id(name, slug)')
  .eq('slug', Astro.params.slug)
  .single();
---

{product ? (
  <Layout title={`${product.name} — Anfal Watches`}>
    <div class="detail-page">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        {product.categories && (
          <>
            <a href={`/watches?category=${product.categories.slug}`}>{product.categories.name}</a>
            <span>/</span>
          </>
        )}
        <span>{product.name}</span>
      </nav>

      <ProductDetail
        client:load
        productId={product.id}
        productName={product.name}
        price={product.price}
        stock={product.stock}
        images={product.images || []}
      />
    </div>
  </Layout>
) : (
  <Layout title="Not Found — Anfal Watches">
    <div class="detail-page">
      <h1 class="headline-lg">Product not found</h1>
      <a href="/watches" class="body-md">Browse all watches</a>
    </div>
  </Layout>
)}

<style>
  .detail-page {
    max-width: 1440px;
    margin: 0 auto;
    padding: 32px 16px;
  }

  .breadcrumb {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 32px;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .breadcrumb a {
    color: var(--fg-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .detail-gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .main-image {
    aspect-ratio: 1;
    cursor: zoom-in;
    overflow: hidden;
  }

  .main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-image-placeholder {
    width: 100%;
    height: 100%;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
  }

  .thumbnail-strip {
    display: flex;
    gap: 8px;
  }

  .thumbnail {
    width: 64px;
    height: 64px;
    padding: 0;
    border: 1px solid var(--border);
    cursor: pointer;
    overflow: hidden;
    background: none;
  }

  .thumbnail.active {
    border-color: var(--accent);
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .detail-name {
    font-family: Roboto, sans-serif;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    margin: 0;
  }

  .detail-price {
    font-family: Roboto, sans-serif;
    font-weight: 700;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1;
    margin: 0;
  }

  .stock-indicator {
    font-family: Inter, sans-serif;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .stock-indicator.in {
    color: var(--success);
  }

  .stock-indicator.out {
    color: var(--error);
  }

  .order-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 8px;
  }

  .qty-selector {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .qty-controls {
    display: flex;
    align-items: center;
    gap: 0;
    border: 1px solid var(--border);
    width: fit-content;
  }

  .qty-controls button {
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    color: var(--fg);
    font-size: 1.25rem;
    cursor: pointer;
  }

  .qty-controls button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .qty-controls span {
    width: 48px;
    text-align: center;
    font-family: Inter, sans-serif;
    font-size: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .field input,
  .field textarea {
    padding: 10px 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    font-family: Inter, sans-serif;
    font-size: 1rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .field textarea {
    resize: vertical;
  }

  .error-msg {
    color: var(--error);
    font-size: 0.875rem;
    margin: 0;
  }

  .btn-order {
    padding: 14px 24px;
    background: var(--accent);
    color: var(--bg-elevated);
    border: none;
    font-family: Inter, sans-serif;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .btn-order:hover:not(:disabled) {
    opacity: 0.85;
  }

  .btn-order:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 300;
    cursor: zoom-out;
  }

  .lightbox img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    cursor: default;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 24px;
    background: none;
    border: none;
    color: white;
    font-size: 2rem;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .detail-layout {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
