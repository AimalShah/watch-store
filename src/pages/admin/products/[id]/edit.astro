---
import Layout from '../../../../layouts/Layout.astro';
import { AdminLayout } from '../../../../components/admin/admin-layout';
import { ProductForm } from '../../../../components/admin/product-form';
import { createSupabaseServerClient } from '../../../../lib/supabase-server';
import '../../../../styles/admin.css';

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: product } = await supabase
  .from('products')
  .select('*')
  .eq('id', Astro.params.id)
  .single();
---

<Layout title="Edit Product — Anfal Watches Admin">
  <AdminLayout client:load>
    <div class="admin-header">
      <h2 class="headline-md">Edit Product</h2>
    </div>
    {product ? (
      <ProductForm
        client:load
        initial={{
          name: product.name,
          slug: product.slug,
          description: product.description || '',
          price: String(product.price),
          stock: String(product.stock),
          category_id: product.category_id || '',
          featured: product.featured,
          images: product.images || [],
        }}
        onSave={async (data) => {
          const res = await fetch(`/api/products/${product.id}`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ...data, price: parseFloat(data.price), stock: parseInt(data.stock) || 0 }),
          });
          if (!res.ok) {
            const err = await res.json();
            throw new Error(err.error || 'Failed to update');
          }
          window.location.href = '/admin/products';
        }}
      />
    ) : (
      <p class="body-md" style={{ color: 'var(--error)' }}>Product not found.</p>
    )}
  </AdminLayout>
</Layout>
