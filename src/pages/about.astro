---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Anfal Watches">
  <div class="page">
    <div class="page-inner">
      <h1 class="headline-lg">About Anfal Watches</h1>
      <div class="about-content">
        <p class="body-lg">
          Anfal Watches is a premium watch retailer dedicated to offering authentic, high-quality timepieces
          to discerning customers. We curate a selection of the finest watches from renowned brands,
          ensuring every piece in our collection meets the highest standards of craftsmanship and design.
        </p>
        <p class="body-md">
          Our mission is simple: make luxury watch buying accessible, transparent, and personal.
          We believe in building relationships with our customers, not just processing transactions.
          That's why every order is handled through a real conversation on WhatsApp — so you can ask
          questions, get recommendations, and buy with confidence.
        </p>
        <p class="body-md">
          Based in Pakistan, we ship nationwide and are committed to providing an exceptional
          experience from browse to delivery.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page {
    padding: 64px 16px;
  }

  .page-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .page h1 {
    margin: 0 0 32px;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-content p {
    margin: 0;
    color: var(--fg-muted);
  }
</style>
